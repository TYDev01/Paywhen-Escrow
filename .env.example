# ---------------------------------------------------------------------------
# Escrow Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# All values are validated at boot (apps/api/src/config/env.validation.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
API_GLOBAL_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://escrow:escrow@localhost:5432/escrow?schema=public

# --- Redis (queues, cache, rate-limit) ---
REDIS_URL=redis://localhost:6379

# --- Auth / sessions ---
# Generate strong secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# --- Payment provider (integration boundary) ---
# Leave PAYMENTS_PROVIDER=none to run with live money movement DISABLED.
# Supported adapters: none | stripe
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Identity verification / KYC (integration boundary) ---
# Leave KYC_PROVIDER=none
# Private document storage. Generate once with: openssl rand -base64 32
# Preserve the key for access to previously stored documents.
KYC_DOCUMENT_KEY= to keep verification in a truthful "unavailable" state.
KYC_PROVIDER=none
# Private document storage. Generate once with: openssl rand -base64 32
# Preserve the key for access to previously stored documents.
KYC_DOCUMENT_KEY=

# --- Email (notifications) ---
# Leave MAIL_TRANSPORT=log to write emails to the application log instead of sending.
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM="Escrow <no-reply@example.com>"

# --- Object storage (evidence / uploads) ---
# s3-compatible; leave STORAGE_DRIVER=local for dev disk storage.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
